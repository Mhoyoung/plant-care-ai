# 이 파일을 secrets.toml로 복사하고, 본인 PC에서만 키를 입력하세요.
# 결제를 연결하지 않은 Free Tier 프로젝트의 키를 사용하세요.
GEMINI_API_KEY = ""

# 개인 PC에서는 local을 유지합니다. 팀원용 앱의 외부 저장소 설정은 docs/CLOUD_STORAGE.md를 참고하세요.
STORAGE_BACKEND = "local"
SUPABASE_URL = ""
SUPABASE_SECRET_KEY = ""
# 공유 앱: personal.sql 적용 후 개인 정원 사용. 기존 팀 정원은 그대로 보존됩니다.
GARDEN_MODE = "personal"
SUPABASE_PUBLISHABLE_KEY = ""
